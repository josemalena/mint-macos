[
  // Con keyd (keyd/default.conf), ⌘ + letra llega a VS Code como Ctrl + letra
  // y ⌥←/→ como Ctrl+←/→, así que los atajos de Linux de VS Code ya hacen lo
  // de macOS (⌘S, ⌘P, ⌘⇧P, ⌘F, ⌘/, ⌘D, ⌘B…). Aquí solo va lo que keyd deja
  // pasar como Super o lo que en Linux tiene otra combinación.

  // ⌘⌥F reemplazar: llega como Ctrl+Alt+F.
  { "key": "ctrl+alt+f", "command": "editor.action.startFindReplaceAction" },

  // ⌘1…3 y ⌘⇧[ ] no se traducen: llegan como Super (meta).
  { "key": "meta+1", "command": "workbench.action.focusFirstEditorGroup" },
  { "key": "meta+2", "command": "workbench.action.focusSecondEditorGroup" },
  { "key": "meta+3", "command": "workbench.action.focusThirdEditorGroup" },
  { "key": "meta+shift+[", "command": "workbench.action.previousEditor" },
  { "key": "meta+shift+]", "command": "workbench.action.nextEditor" }
]
