@@ -38,6 +38,28 @@
 
 const ShouldAnimateManager = require("ShouldAnimateManager.js");
 
+// mint-macos: la duración sale del perfil de la versión de macOS (apps/animaciones.json, «genio-minimizar» y «genio-restaurar»,
+// medidas en los videos de la Mac); sin perfil o sin ese número queda la del ajuste «duration» de la extensión.
+function duracionDelPerfil(clave) {
+   try {
+      let ruta = (name) => GLib.build_filenamev([name, "mint-macos", "macos.json"]);
+      let id = null;
+      for (let dir of [GLib.get_user_runtime_dir(), GLib.get_user_config_dir()]) {
+         try {   // file_get_contents lanza si el archivo no está
+            let [ok, bytes] = GLib.file_get_contents(ruta(dir));
+            if (ok) { id = JSON.parse(imports.byteArray.toString(bytes)).version; break; }
+         } catch (e) {}
+      }
+      if (!id) return null;
+      let [ok2, datos] = GLib.file_get_contents(GLib.build_filenamev([GLib.get_user_data_dir(), "mint-macos", "macos", id, "apps", "animaciones.json"]));
+      if (!ok2) return null;
+      let ms = JSON.parse(imports.byteArray.toString(datos)).comportamiento[clave].ms;
+      return ms > 0 ? ms : null;
+   } catch (e) {
+      return null;
+   }
+}
+
 const MINIMIZE_EFFECT_NAME = "minimize-magic-lamp-effect";
 const UNMINIMIZE_EFFECT_NAME = "unminimize-magic-lamp-effect";
 
