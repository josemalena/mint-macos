@@ -160,6 +160,32 @@ sequence_is_pointer_emulated (MetaDisplay        *display,
   return FALSE;
 }
 
+/*
+ * mint-macos: una ventana con una hoja de macOS abierta (un transient con WM_WINDOW_ROLE «mint-macos-hoja», aunque sea de otro proceso)
+ * no recibe clics en su contenido; la barra de título sí (se mueve) y el resto de la app queda libre (informe de Open/Save en Monterey,
+ * §5; igual desde Tiger según José, 28-10-2026).
+ */
+static gboolean
+window_has_sheet_cb (MetaWindow *transient,
+                     void       *data)
+{
+  if (!transient->unmanaging && g_strcmp0 (transient->role, "mint-macos-hoja") == 0)
+    {
+      *((gboolean *) data) = TRUE;
+      return FALSE;
+    }
+  return TRUE;
+}
+
+static gboolean
+window_has_sheet (MetaWindow *window)
+{
+  gboolean has = FALSE;
+
+  meta_window_foreach_transient (window, window_has_sheet_cb, &has);
+  return has;
+}
