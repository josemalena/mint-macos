+/*
+ * mint-macos: la forma de la hoja de macOS depende de la versión del perfil (macos.json, «version»): hasta Catalina cuelga de la barra
+ * de título de su ventana madre (capturas de High Sierra 10.13.6, 27-10-2026); desde Monterey flota centrada sobre ella, sin subir del borde
+ * de abajo de la barra de título (informe de Open/Save en Monterey 12.7.6, 28-10-2026). Sin archivo se asume Catalina, el perfil por defecto.
+ */
+static gboolean
+mint_macos_sheet_hangs_from_title (void)
+{
+  const char *dirs[2] = { g_get_user_runtime_dir (), g_get_user_config_dir () };
+  int i;
+
+  for (i = 0; i < 2; i++)
+    {
+      g_autofree char *path = NULL;
+      g_autofree char *text = NULL;
+      const char *p;
+
+      if (!dirs[i])
+        continue;
+      path = g_build_filename (dirs[i], "mint-macos", "macos.json", NULL);
+      if (!g_file_get_contents (path, &text, NULL, NULL))
+        continue;
+      p = strstr (text, "\"version\"");
+      if (!p)
+        continue;
+      p = strchr (p + 9, '"');
+      if (!p)
+        continue;
+      p++;
+      return !(g_str_has_prefix (p, "monterey") || g_str_has_prefix (p, "sequoia") ||
+               g_str_has_prefix (p, "macos-27") || g_str_has_prefix (p, "tahoe") ||
+               g_str_has_prefix (p, "ventura") || g_str_has_prefix (p, "sonoma") ||
+               g_str_has_prefix (p, "big-sur") || g_str_has_prefix (p, "bigsur"));
+    }
+
+  return TRUE;
+}
