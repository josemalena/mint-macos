[media-keys]
area-screenshot=@as []
area-screenshot-clip=['<Shift><Super>dollar']
logout=['<Shift><Super>q']
screensaver=['<Control><Super>q']
screenshot-clip=@as []
window-screenshot-clip=['<Shift><Super>percent']

[wm]
switch-group=['<Super>Above_Tab']
switch-group-backward=['<Shift><Super>Above_Tab']
switch-windows=['<Super>Tab']
switch-windows-backward=['<Shift><Super>Tab']
